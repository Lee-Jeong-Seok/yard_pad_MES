# Node.js Server Configuration
PORT=3300
NODE_ENV=development

# MSSQL Database Configuration (기존 MES 사내 DB)
DB_SERVER=192.168.0.100
DB_PORT=1433
DB_NAME=MES_DB
DB_USER=mes_user
DB_PASSWORD=mes_password!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
